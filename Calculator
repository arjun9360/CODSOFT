#Calculator Program

import math
def add(x, y):
    return x + y
def subtract(x, y):
    return x - y
def multiply(x, y):
    return x * y
def divide(x, y):
    if y == 0:
        return "Error! Division by zero is not allowed."
    return x / y
def exponent(x, y):
    return x ** y  # or pow(x, y)
def modulus(x, y):
    if y == 0:
        return "Error! Modulus by zero is undefined."
    return x % y
def square_root(x):
    if x < 0:
        return "Error! Cannot calculate square root of a negative number."
    return math.sqrt(x)
def calculator():
    print("\nWelcome to the Python Advanced Calculator")
    print("------------------------------------------")
    print("Select an operation to perform:")
    print("1. Addition (+)")
    print("2. Subtraction (-)")
    print("3. Multiplication (*)")
    print("4. Division (/)")
    print("5. Exponent (x ** y)")
    print("6. Modulus (x % y)")
    print("7. Square Root (√x)")
    while True:
        choice = input("\nEnter choice (1-7): ")

        if choice not in ('1', '2', '3', '4', '5', '6', '7'):
            print("Invalid choice. Please select from 1 to 7.")
            continue
        try:
            if choice == '7':
                num = float(input("Enter number: "))
            else:
                num1 = float(input("Enter first number: "))
                num2 = float(input("Enter second number: "))
        except ValueError:
            print("Invalid input! Please enter numeric values.")
            continue
        if choice == '1':
            result = add(num1, num2)
            operation = '+'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '2':
            result = subtract(num1, num2)
            operation = '-'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '3':
            result = multiply(num1, num2)
            operation = '*'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '4':
            result = divide(num1, num2)
            operation = '/'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '5':
            result = exponent(num1, num2)
            operation = '**'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '6':
            result = modulus(num1, num2)
            operation = '%'
            print(f"\nResult: {num1} {operation} {num2} = {result}")
        elif choice == '7':
            result = square_root(num)
            print(f"\nResult: √{num} = {result}")
        next_calc = input("\nDo you want to perform another calculation? (yes/no): ").strip().lower()
        if next_calc != 'yes':
            print("\nThank you for using the Advanced Calculator. Have a great day!")
            break
if __name__ == "__main__":
    calculator()

